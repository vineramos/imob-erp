# Backend
DATABASE_URL=
NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=
BOOTSTRAP_ADMIN_EMAIL=
APP_ENV=development
APP_NAME=Imob ERP Imobiliario
CORS_ORIGINS=http://localhost:5173


# Assinatura eletrônica / Clicksign
# Segredos devem entrar por ambiente/Secret Manager.
CLICKSIGN_ENVIRONMENT=sandbox
CLICKSIGN_ACCESS_TOKEN=
CLICKSIGN_WEBHOOK_SECRET=

# Banco Inter Empresas / OAuth2 + mTLS
# Em produção, prefira montar certificado/chave a partir de Secret Manager.
INTER_ENVIRONMENT=sandbox
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=
INTER_KEY_PATH=
INTER_ACCOUNT_NUMBER=
INTER_WEBHOOK_SECRET=

# Storage persistente de documentos.
# Vazio = fallback para PostgreSQL/Neon; preenchido = Google Cloud Storage.
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_PREFIX=imob-erp

# E-mail transacional / Central de Comunicações / Portal do Cliente
# Senhas e credenciais devem entrar por ambiente/Secret Manager.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM_EMAIL=
# Vazio = usa o nome da organização no remetente.
EMAIL_SMTP_FROM_NAME=
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_USE_SSL=false

# WhatsApp Business Platform / Cloud API oficial da Meta
# Segredos devem entrar por ambiente/Secret Manager.
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# DDI aplicado quando o cadastro local não informar DDI explicitamente.
WHATSAPP_DEFAULT_COUNTRY_CODE=55

# Frontend
VITE_API_URL=http://localhost:8000/api
VITE_NEON_AUTH_URL=
